# Copy to .env (or export in the shell) on the deploy host. No real secrets here.

# Root of the bind-mounted data disk on the host (must exist and be mounted)
DATA_ROOT=/srv/magnus

# Image to deploy, pinned by tag or digest, e.g. registry.example.com/magnus-blog:1.0.0
APP_IMAGE=registry.example.com/magnus-blog:0.1.0

# The one and only admin username (password hash lives in /etc/magnus/secrets/)
APP_ADMIN_USERNAME=change-me
